# Copy this file to Backend/.env and fill it in. Backend/.env is never committed.
# Make random values with:  python -c "import secrets; print(secrets.token_hex(24))"

# --- On the server (used by docker-compose.yml through deploy.ps1) ---
# Signs sign-in tokens. Keep private; changing it signs everyone out once.
JWT_SECRET_KEY=
# Database password. Only applied when the database is first created; to change it on an
# existing database, see README (Secrets).
POSTGRES_PASSWORD=
# Optional: first admin's password on a brand-new database (must be changed at first sign-in)
# ADMIN_INITIAL_PASSWORD=
# One signed-in device per account. Load-test accounts sign in many times at once, so list
# them here (comma-separated). SINGLE_SESSION=false turns the rule off.
SINGLE_SESSION_EXEMPT=loadtest,loadtestadmin

# --- Backups (Backend/backup) ---
# Encrypts every backup (AES-256). Without it the backups can't be opened: keep a copy somewhere
# other than the server. Make one with: python -c "import secrets; print(secrets.token_urlsafe(30))"
BACKUP_PASSPHRASE=
# Optional: where the backups go (default: the backups folder next to deploy.ps1), the hour of the
# nightly backup, and how many to keep
# BACKUP_DIR=D:\CAIC\backups
# BACKUP_HOUR=2
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# BACKUP_KEEP_MONTHLY=6

# --- On a developer's laptop (running uvicorn by hand) ---
# Ask the server owner for the database password. Use the test database, never caic_db.
DATABASE_URL=postgresql+psycopg://postgres:<password>@database.nyala-ordinal.ts.net:5432/caic_db_test
